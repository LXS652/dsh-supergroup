{
  "name": "dsh-supergroup",
  "version": "1.1.0",
  "description": "DSH 多会话编排插件：按会话 ID 派工、按 rpcId 回收结果、重启后自动对账自愈。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXS652/dsh-supergroup.git"
  },
  "homepage": "https://github.com/LXS652/dsh-supergroup",
  "bugs": {
    "url": "https://github.com/LXS652/dsh-supergroup/issues"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./src/plugin2.mjs",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "multi-agent",
    "orchestration",
    "plugin"
  ]
}
